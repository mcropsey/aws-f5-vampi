# ─────────────────────────────────────────────────────────────────────────────
# mcropsey-f5 lab — shared settings. Sourced by every script in this folder.
#
# This is the F5-fronted VAmPI environment. Its twin lives in
# ../aws-api-gw-vampi (prefix mcropsey-aws-gw) and shares nothing with it:
# separate VPC, separate stack, separate outputs file.
# ─────────────────────────────────────────────────────────────────────────────

# Every resource name and tag in the stack derives from this.
PREFIX="mcropsey-f5"

REGION="us-east-2"
AZ="us-east-2a"
STACK_NAME="mcropsey-f5-vampi"
KEY_NAME="mcropsey-key"
KEY_FILE="$HOME/.ssh/mcropsey-key.pem"
TEMPLATE="mcropsey-lab.yaml"

# Instance sizes (m5.xlarge is required by the F5 PAYG 25Mbps listing)
VAMPI_INSTANCE_TYPE="t3.medium"
F5_INSTANCE_TYPE="m5.xlarge"
K3S_INSTANCE_TYPE="m5.4xlarge"

# BIG-IP admin password, used for iControl REST auth in 02-configure-f5.sh.
# Leave empty to be prompted. Export F5_ADMIN_PASSWORD to run non-interactively.
F5_ADMIN_PASSWORD="${F5_ADMIN_PASSWORD:-}"

# Written by 01-deploy-aws.sh, read by 02/03/99
OUTPUTS_FILE="lab-outputs.env"
